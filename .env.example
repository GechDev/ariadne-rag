# ARIADNE environment configuration.
# Copy to `.env` and adjust for your local setup.

# Runtime
ARIADNE_APP_NAME=ARIADNE
ARIADNE_ENVIRONMENT=development
ARIADNE_DEBUG=true
ARIADNE_LOG_LEVEL=INFO

# API
ARIADNE_API_TITLE=ARIADNE API
ARIADNE_API_VERSION=0.1.0

# Database (SQLite by default for local-first operation)
ARIADNE_DATABASE__URL=sqlite:///./ariadne.db

# Storage
ARIADNE_STORAGE__UPLOAD_DIR=storage/uploads

# CORS
ARIADNE_CORS__ORIGINS=["http://localhost:5173","http://localhost:3000"]
